@page "/ChaletEdit/{OwnerId:guid}"
@page "/ChaletEdit/{OwnerId:guid}/ChaletId/{ChaletId:guid}"

@using Project2025.Data.Entity
@using Project2025.Components.Pages.ChaletComponents
@rendermode InteractiveServer
@inject IChaletServices _chaletServices
@inject NavigationManager NavigationManager
@inject ISnackbar snackbar


<h1>تعديل شالية</h1>

@if (chalet == null)
{
    <div class="d-flex justify-center align-center ma-auto">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else
{
    <MudForm Model="chalet" @ref="form">
        <MudCard Elevation="6">
            <MudCardHeader>
                <MudText Typo="Typo.h5" Align="Align.Center">@PageHeaderText</MudText>
            </MudCardHeader>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="chalet.OwnerId"
                              Label="OwnerID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="chalet.ChaletId"
                              Label="ChaletID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>


            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="chalet.location"
                              Label="location"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="chalet.price"
                              Label="price"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="chalet.area"
                              Label="area"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudCardActions Class="d-flex justify-end mt-2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="HandLeSaveAsync">حفظ</MudButton>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandLeSaveAndCloseAsync">حفظ وإغلاق</MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Home"
                           OnClick="NavigateToMainPagee">
                   الرجوع

                   
                </MudButton>
              
            </MudCardActions>
        </MudCard>
    </MudForm>
}

@code {
    [Parameter]
    public Guid? OwnerId { get; set; }

    [Parameter]
    public Guid ChaletId { get; set; }

    protected MudForm? form;
    protected bool success = false;
    private string PageHeaderText = "اضافة شالية جديد";
    private Chalet chalet { get; set; } = new Chalet();

    protected override async Task OnInitializedAsync()
    {
        if (ChaletId == Guid.Empty)
        {
            PageHeaderText = "اضافة شالية جديد";
            chalet = new Chalet();

            if (OwnerId.HasValue && OwnerId != Guid.Empty)
                chalet.OwnerId = OwnerId.Value;
        }
        else
        {
            PageHeaderText = "تعديل الشاليه";
            chalet = await _chaletServices.GetChaletByChaletId(ChaletId);
        }
    }

    private async Task HandLeSaveAsync()
    {
        await _chaletServices.Upsert(chalet);
        snackbar.Add("✅ تم تعديل بيانات الشاليه بنجاح", Severity.Success);
    }

    private async Task HandLeSaveAndCloseAsync()
    {
        await _chaletServices.Upsert(chalet);
        snackbar.Add("✅ تم تعديل بيانات الشاليه بنجاح", Severity.Success);
        NavigationManager.NavigateTo($"/View/{chalet.OwnerId}");
    }
    public void NavigateToMainPagee()
    {
        NavigationManager.NavigateTo($"/View/{chalet.OwnerId}");
    }
}
