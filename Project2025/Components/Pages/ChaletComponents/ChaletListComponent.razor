@page "/ChaletListComponent"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@using Project2025.Data.Entity
@inject IChaletServices ChaletServices
<h3>ChaletListComponent</h3>

<MudTable Items="Chalets" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">
    <ToolBarContent>
        <MudSpacer />
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   @onclick="NavigateToAddChalet">Add</MudButton>

    </ToolBarContent>
    <HeaderContent>
        <MudTh>ChaletId</MudTh>
        <MudTh>price</MudTh>
        <MudTh>location</MudTh>
        <MudTh> OwnerId</MudTh>


    </HeaderContent>
    <RowTemplate>

        <MudTd DataLabel="ChaletId">@context.ChaletId</MudTd>
        <MudTd DataLabel="price">@context.price</MudTd>
        <MudTd DataLabel="location">@context.location</MudTd>
        <MudTd DataLabel="OwnerId">@context.OwnerId</MudTd>
        <MudTd>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="()=>NavigateToEditChalet(context)" />


            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="()=>DeleteChalet(context)" />


        </MudTd>


    </RowTemplate>
</MudTable>


@code {
    private bool _loading = false;
    public List<Chalet> Chalets { get; set; } = new List<Chalet>();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(2000);
        // Chalet = await _ownerDesignServices.GetChalet();
        _loading = false;
    }

    public void NavigateToAddChalet()
    {
        NavigationManager.NavigateTo("ChaletEdit");
    }
    public void NavigateToEditChalet(Chalet chalet)
    {
        NavigationManager.NavigateTo($"ChaletEdit/{chalet.ChaletId}");
    }

    public async Task DeleteChalet(Chalet chalet)
    {
        await ChaletServices.DeleteAsync(chalet);
        Chalets.Remove(chalet);
       
    }

}





