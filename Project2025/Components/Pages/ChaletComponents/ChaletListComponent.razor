@page "/ChaletListComponent"
@using Project2025.Data.Entity
@using Project2025.Components.Pages.ChaletComponents
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IChaletServices ChaletServices
@inject NavigationManager NavigationManager
@inject ISnackbar snackbar
@inject IDialogService DialogService



<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider MaxDisplayedSnackbars="3"
                     PreventDuplicates="true"
                     Position="SnackbarPosition.TopLeft" />



<MudTable Items="Chalets" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">
    <ToolBarContent>
        <MudSpacer />
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   @onclick="NavigateToAddChalet">Add Chalet</MudButton>


        <MudButton Color="Color.Secondary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   @onclick="NavigateBack">القائمة الاساسية</MudButton>
            @* رجوع *@
           
        
    </ToolBarContent>
    <HeaderContent>
        <MudTh>المالك</MudTh>     
        <MudTh>price</MudTh>
        <MudTh>location</MudTh>
        <MudTh>area</MudTh>

@*          <MudTh> OwnerId</MudTh>
 *@ 

    </HeaderContent>
    <RowTemplate>

@*         <MudTd DataLabel="ChaletId">@context.ChaletId</MudTd>
 *@

        <MudTd DataLabel="المالك">@context.PropertyOwner?.ownerName</MudTd>
  <MudTd DataLabel="price">@context.price</MudTd>
        <MudTd DataLabel="location">@context.location</MudTd>
         <MudTd DataLabel="price">@context.area</MudTd>
        
      
@*         <MudTd DataLabel="OwnerId">@context.OwnerId</MudTd>
 *@        <MudTd>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="()=>NavigateToEditChalet(context)" />


            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="()=>ConfirmDelete(context)" />


        </MudTd>


    </RowTemplate>
</MudTable>


@code {
    // [CascadingParameter]
    // public Guid Id { get; set; }

    [CascadingParameter] public Guid Id { get; set; }
    private bool _loading = false;
    public List<Chalet> Chalets { get; set; } = new List<Chalet>();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(2000);
        Chalets = await ChaletServices.GetChaletsByOwnerId(Id);
        _loading = false;
    }


    public void NavigateToAddChalet( )
    {
        NavigationManager.NavigateTo($"ChaletEdit/{Id}");
    }

    // دالة للرجوع إلى الصفحة السابقة
   
       
       

        private void NavigateBack()
        {
           
            NavigationManager.NavigateTo("PropertyOwnerListComponent");
        }
    


    public void NavigateToEditChalet(Chalet chalet)
    {
NavigationManager.NavigateTo($"ChaletEdit/{chalet.OwnerId}/ChaletId/{chalet.ChaletId}");
    }

    public async Task DeleteChalet(Chalet chalet)
    {
        await ChaletServices.DeleteAsync(chalet);
        snackbar.Add("🗑️ تم حذف الشاليه بنجاح", Severity.Warning);
        Chalets.Remove(chalet);
       
    }

    private async Task ConfirmDelete(Chalet chalet)
    {
        bool? result = await DialogService.ShowMessageBox(
            title: "تأكيد الحذف",
            markupMessage: (MarkupString)$" هل أنت متأكد أنك تريد حذف الشلي <b>{chalet.location}</b>؟",
            yesText: "نعم",
            noText: "إلغاء"
        );

        if (result == true)
        {
            await DeleteChalet(chalet);
        }
    }

}





