@page "/PropertyOwnerEdit"
@page "/PropertyOwnerEdit/{Id:guid}"
@using Project2025.Components.Pages.ChaletComponents
@using Project2025.Data.Entity
@rendermode InteractiveServer
@inject IPropertyOwnerService _propertyOwnerServices
@inject NavigationManager NavigationManager
@inject ISnackbar snackbar




@if (propertyOwner == null)
{
    <div class="d-flex justify-center align-center ma-auto">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else
{
    <MudForm Model="propertyOwner" @ref="form">
        <MudCard Elevation="6">
            <MudCardHeader>
                <MudText Typo="Typo.h5" Align="Align.Center">@PageHeaderText</MudText>
            </MudCardHeader>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="propertyOwner.ownerName"
                              Label="Name"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="propertyOwner.email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="propertyOwner.phone"
                              Label="Phone"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudCardActions Class="d-flex justify-end mt-2">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           OnClick="HandLeSaveAsync">حفظ</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandLeSaveAndCloseAsync">حفظ وإغلاق</MudButton>

                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Home"
                           OnClick="NavigateToMainPage">
                    القائمة الرئيسية

                   
                </MudButton>

            </MudCardActions>
        </MudCard>
    </MudForm>
}

@* 
{
    <CascadingValue Value="Id">
        <ChaletListComponent />
    </CascadingValue>
} *@

@code {
    protected MudForm? form;
    protected bool success = false;
    private string PageHeaderText = "إضافة صاحب شالية جديد";
    bool _centered = true;

    [Parameter] public Guid Id { get; set; }
    private PropertyOwner propertyOwner { get; set; } = new PropertyOwner();

    protected override async Task OnInitializedAsync()
    {
        if (Id == Guid.Empty)
        {
            PageHeaderText = "إضافة صاحب شالية جديد";
            propertyOwner = new PropertyOwner();
        }
        else
        {
            PageHeaderText = "تعديل صاحب الشاليه";
            propertyOwner = await _propertyOwnerServices.GetPropertyOwnerByownerId(Id);
        }
    }

    private async Task HandLeSaveAsync()
    {
        propertyOwner = await _propertyOwnerServices.Upsert(propertyOwner);
        snackbar.Add("تم الحفظ بنجاح", Severity.Success);

    }
    private void NavigateToMainPage()
    {
        NavigationManager.NavigateTo("/PropertyOwnerListComponent");
    }

    private async Task HandLeSaveAndCloseAsync()
    {
        propertyOwner = await _propertyOwnerServices.Upsert(propertyOwner);
        snackbar.Add("تم الحفظ بنجاح", Severity.Success);
        await Task.Delay(1000);
        NavigationManager.NavigateTo("PropertyOwnerListComponent");

    }
}
