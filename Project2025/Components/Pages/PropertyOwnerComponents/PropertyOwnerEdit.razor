@page "/PropertyOwnerEdit"
@page "/PropertyOwnerEdit/{ownerId:guid}"
@inject IPropertyOwnerService _propertyOwnerServices
@inject NavigationManager NavigationManager
@* @inject ISnackbar Snackbar *@
@using Project2025.Components.Pages.ChaletComponents
@using Project2025.Data.Entity


@if (propertyOwner == null)
{
    <div class="d-flex justify-center align-center ma-auto">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
    </div>
}
else
{
    <MudForm Model="propertyOwner" @ref="form">
        <MudCard Elevation="6">
            <MudCardHeader>
                <MudText Typo="Typo.h5" Align="Align.Center"> @PageHeaderText</MudText>
            </MudCardHeader>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="propertyOwner.ownerName"
                Label="Name"
                Variant="Variant.Outlined"
                Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="propertyOwner.email"
                Label="email"
                Variant="Variant.Outlined"
                Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" md="12" lg="12">
                <MudTextField @bind-Value="propertyOwner.phone"
                Label="phone"
                Variant="Variant.Outlined"
                Margin="Margin.Dense" />
            </MudItem>

            <MudCardActions Class="d-flex justify-end mt-2">
                <MudButton Variant="Variant.Outlined"
                CoLor="Color.Primary"
                @OnClick="HandLeSaveAsync">حفظ </MudButton>
                <MudButton Variant="Variant.Filled"
                CoLor="Color.Primary"
                @OnClick="HandLeSaveAndCloseAsync">حفظ واغلاق</MudButton>

            </MudCardActions>


        </MudCard>

    </MudForm>


}




<ChaletListComponent/>

@code {
    protected MudForm? form;
    protected bool success = false;
    private string PageHeaderText = "اضافة صاحب شالية جديد";



    [Parameter] public Guid ownerId { get; set; }
    private PropertyOwner propertyOwner { get; set; } = new PropertyOwner();

    protected override async Task OnInitializedAsync()
    {
        if (ownerId == Guid.Empty)
        {
            PageHeaderText = "اضافة صاحب شالية جديد";
            propertyOwner = new PropertyOwner();

        }

        else
        {
            PageHeaderText = " تعديل صاحب الشاليه";
            propertyOwner = await _propertyOwnerServices.GetPropertyOwnerByownerId(ownerId);
        }
    }

    private async Task HandLeSaveAsync()
    {
       
            await _propertyOwnerServices.Upsert(propertyOwner);
           

    }

    private async Task HandLeSaveAndCloseAsync()
    {
       
            await _propertyOwnerServices.Upsert(propertyOwner);

        
  
        NavigationManager.NavigateTo("/PropertyOwnerListComponent");
    }







}