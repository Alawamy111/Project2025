@page "/PropertyOwnerListComponent"
@using Project2025.Data.Entity
@rendermode InteractiveServer
@inject PropertyOwnerDesignServices _PropertyOwnerDesignServices
@inject NavigationManager NavigationManager
<MudTable Items="PropertyOwners" Hover="true" Loading="@_loading" LoadingProgressColor="Color.Info">

    <ToolBarContent>
        <MudSpacer />

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   onclick="NavigateToAddPropertyOwner">Add</MudButton> <!--   داله الاضافه-->



    </ToolBarContent>
    <HeaderContent>
        <MudTh>ownerId</MudTh>
        <MudTh>ownerName</MudTh>
        <MudTh>email</MudTh>
        <MudTh> Operations</MudTh>


    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="ownerId">@context.ownerId</MudTd>
        <MudTd DataLabel="ownerName">@context.ownerName</MudTd>
        <MudTd DataLabel="email">@context.email</MudTd>
        <MudTd>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Edit" onclick="NavigateToAddPropertyOwner">Edit</MudButton>

            <MudButton Color="Color.Error"
                       Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="()=> DeletePropertyOwner(context)" />

        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private bool _loading = false;
    public List<PropertyOwner> PropertyOwners { get; set; } = new List<PropertyOwner>();
    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        await Task.Delay(0);
        PropertyOwners = _PropertyOwnerDesignServices.GetPropertyOwners();
        _loading = false;

    }

    public void NavigateToAddPropertyOwner()
    {
        NavigationManager.NavigateTo("PropertyOwnerEdit");    // الصفحة الي تصير فيها عمليه الاضافة //
    }


    public void DeletePropertyOwner(PropertyOwner propertyOwner)
    {
        PropertyOwners.Remove(propertyOwner);

    }
}